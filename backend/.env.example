MONGO_URL=mongodb://localhost:27017
DB_NAME=dharmasearch
MONGO_TIMEOUT_MS=5000
MONGO_MAX_POOL_SIZE=20

# Generate independent random values in production. Never commit real secrets.
JWT_SECRET=
RATE_LIMIT_SALT=

# Comma-separated origins, with no wildcard when credentials are enabled.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://dharmasearch-demo.netlify.app
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY_HEADERS=false

# Direct OpenAI integrations.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=1

# Anonymous TTS and authenticated AI limits.
TTS_REQUESTS_PER_MINUTE=30
TTS_GENERATIONS_PER_MINUTE=5
TTS_GLOBAL_GENERATIONS_PER_MINUTE=10
TTS_CACHE_MAX_ENTRIES=350
TTS_CACHE_TTL_HOURS=24
TTS_MAX_AUDIO_BYTES=500000
TTS_CLAIM_TIMEOUT_SECONDS=120
TTS_CLAIM_WAIT_SECONDS=30
AI_RATE_LIMIT_PER_MINUTE=10
AI_CONTEXT_VERSES=1500

# Optional. Both values are required together; existing passwords are never reset.
ADMIN_EMAIL=
ADMIN_PASSWORD=
